		height: 62rpx;
		background-color: #ff0000;
		border-radius: 8rpx;
		margin: 0rpx 12rpx;
	}

	.btn3 {
		justify-content: center;
		align-items: center;
		width: 62rpx;
		height: 62rpx;
		border-radius: 8rpx;
		margin: 0rpx 12rpx;

	}

	.btnzi {
		font-size: 18px;
